DATABASE_URL=sqlite:///./localfix.db
LOCALFIX_ENV=development
LOCALFIX_FIREBASE_PROJECT_ID=localfix-be333
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-the-repository/service-account.json
LOCALFIX_NOTIFICATION_POLL_SECONDS=15
# Keep false until the Android sign-in flow is connected.
LOCALFIX_AUTH_REQUIRED=false
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_DIRECTORY=./uploads

# Free Render + Neon hobby deployment uses LOCALFIX_ENV=personal and stores
# small completion photos in Neon PostgreSQL: EVIDENCE_STORAGE_BACKEND=database.
# Set DATABASE_URL to Neon's connection string as a Render secret; do not commit it.
# LOCALFIX_BOOTSTRAP_PROPERTY_ID=21a66a51-81b9-42e4-912b-b5c304ad31b3
# LOCALFIX_BOOTSTRAP_PROPERTY_NAME=Your Apartment
# LOCALFIX_BOOTSTRAP_UNIT_LABELS=A-101,A-102,B-101
# LOCALFIX_BOOTSTRAP_MANAGER_UID=Firebase Authentication user UID

# Production PostgreSQL URLs are normalized automatically to use Psycopg:
# DATABASE_URL=postgresql+psycopg://localfix:localfix@localhost:5432/localfix

# Production can provide the Firebase service-account JSON as a secret value
# instead of placing the file inside the deployed container:
# LOCALFIX_FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Cloudflare R2 or another S3-compatible evidence store:
# EVIDENCE_STORAGE_BACKEND=s3
# EVIDENCE_S3_BUCKET=localfix-evidence
# EVIDENCE_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# EVIDENCE_S3_REGION=auto
# EVIDENCE_S3_KEY_PREFIX=completion-evidence
# AWS_ACCESS_KEY_ID=set-as-a-cloud-secret
# AWS_SECRET_ACCESS_KEY=set-as-a-cloud-secret
